---
import { getCollection } from "astro:content";
import SectionHeading from "./ui/SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection("projects", (entry) => entry.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="projects" class="py-20 sm:py-28">
  <div class="mx-auto max-w-[1100px] px-6">
    <SectionHeading index={2} label={t("section.projects")} />
    <div class="grid gap-6 sm:grid-cols-2">
      {
        projects.map((project) => (
          <ProjectCard project={project} slug={project.id.split("/").slice(1).join("/")} lang={lang} />
        ))
      }
    </div>
  </div>
</section>
