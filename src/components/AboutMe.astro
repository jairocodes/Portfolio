---
import SectionHeading from "./ui/SectionHeading.astro";
import Badge from "./ui/Badge.astro";
import { useTranslations, type Lang } from "../i18n/ui";
import { SKILLS } from "../lib/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="py-20 sm:py-28">
  <div class="mx-auto max-w-[1100px] px-6">
    <SectionHeading index={3} label={t("section.about")} />
    <div class="grid gap-10 sm:grid-cols-[1.4fr_1fr]">
      <p class="text-base leading-relaxed text-mist-100 sm:text-lg">
        {t("about.bio")}
      </p>
      <div class="rounded-lg border border-ink-600 bg-ink-800 p-6">
        <p class="mb-4 font-mono text-xs uppercase tracking-wide text-mist-400">
          {t("about.skills")}
        </p>
        <div class="flex flex-wrap gap-2">
          {SKILLS.map((skill) => <Badge label={skill.label} variant={skill.variant} />)}
        </div>
      </div>
    </div>
  </div>
</section>
