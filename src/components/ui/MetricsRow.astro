---
interface Props {
  metrics: { label: string; value: string }[];
}

const { metrics } = Astro.props;
---

<div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
  {
    metrics.map((metric) => (
      <div class="rounded-md border border-ink-600 bg-ink-800 p-4">
        <p class="font-mono text-xl font-medium text-accent sm:text-2xl">{metric.value}</p>
        <p class="mt-1 text-xs text-mist-400">{metric.label}</p>
      </div>
    ))
  }
</div>
