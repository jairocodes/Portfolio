---
interface Props {
  title?: string;
}

const { title = "~/portfolio — zsh" } = Astro.props;
---

<div class="overflow-hidden rounded-lg border border-ink-600 bg-ink-800 shadow-2xl shadow-black/40">
  <div class="flex items-center gap-2 border-b border-ink-600 bg-ink-700 px-4 py-2.5">
    <span class="h-3 w-3 rounded-full bg-[#FF5F56]"></span>
    <span class="h-3 w-3 rounded-full bg-[#FFBD2E]"></span>
    <span class="h-3 w-3 rounded-full bg-[#27C93F]"></span>
    <span class="ml-2 font-mono text-xs text-mist-400">{title}</span>
  </div>
  <div class="p-5 font-mono text-sm text-mist-100">
    <slot />
  </div>
</div>
