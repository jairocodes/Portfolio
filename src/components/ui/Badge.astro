---
interface Props {
  label: string;
  variant?: "lang" | "domain" | "infra";
}

const { label, variant = "lang" } = Astro.props;

const dotColor = {
  lang: "bg-syntax-lang",
  domain: "bg-syntax-domain",
  infra: "bg-syntax-infra",
}[variant];
---

<span
  class="inline-flex items-center gap-1.5 rounded-md border border-ink-600 bg-ink-800 px-2.5 py-1 font-mono text-xs uppercase tracking-wide text-mist-400"
>
  <span class={`h-1.5 w-1.5 rounded-full ${dotColor}`}></span>
  {label}
</span>
